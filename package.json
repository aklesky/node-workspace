{
    "name": "@aklesky/node-presets",
    "version": "0.5.0",
    "license": "MIT",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "prepare": "husky",
        "build": "nx run-many --target=build"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@commitlint/cz-commitlint": "21.2.4",
        "@commitlint/prompt-cli": "21.2.4",
        "@nx/js": "24.0.0",
        "@types/node": "24.19.2",
        "@typescript/native": "npm:typescript@7.0.2",
        "commitizen": "4.3.1",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "nx": "24.0.0",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "rimraf": "6.0.1",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "lint-staged": {
        "**/*.{ts,tsx}": [
            "oxfmt --no-error-on-unmatched-pattern",
            "oxlint --fix"
        ],
        "**/*": "oxfmt --no-error-on-unmatched-pattern"
    },
    "config": {
        "commitizen": {
            "path": "@commitlint/cz-commitlint"
        }
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.22.1",
            "onFail": "download"
        }
    }
}
