{
    "name": "@aklesky/node-workspace",
    "version": "0.5.0",
    "license": "MIT",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.8.0",
    "prettier": "./packages/prettier-config/dist/index.js",
    "scripts": {
        "prepare": "husky",
        "build": "nx run-many --target=build"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@commitlint/cz-commitlint": "21.2.2",
        "@commitlint/prompt-cli": "21.2.2",
        "@nx/js": "23.2.0",
        "@swc-node/register": "1.10.10",
        "@swc/core": "1.11.20",
        "@types/jest": "30.0.0",
        "@types/node": "24.13.3",
        "commitizen": "4.3.1",
        "husky": "9.1.7",
        "jest": "30.5.1",
        "lint-staged": "17.4.1",
        "nx": "23.2.0",
        "rimraf": "6.0.1",
        "ts-node": "10.9.2",
        "typescript": "7.0.2"
    },
    "lint-staged": {
        "**/*.{ts,tsx}": [
            "prettier --write --ignore-unknown",
            "eslint --fix"
        ],
        "**/*": "prettier --write --ignore-unknown"
    },
    "config": {
        "commitizen": {
            "path": "@commitlint/cz-commitlint"
        }
    }
}
