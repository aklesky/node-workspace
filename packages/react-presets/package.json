{
    "name": "@aklesky/react-presets",
    "version": "0.10.0",
    "description": "Shareable Vite presets for React apps, React Server Components and Cloudflare Workers.",
    "author": "Aleksei Semiglasov <aleksey.semiglasov@gmail.com>",
    "homepage": "https://github.com/aklesky/node-workspace#readme",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/preset.d.ts",
            "default": "./dist/preset.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        },
        "./tsconfig/*.json": "./tsconfig/*.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "tsconfig"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aklesky/node-workspace.git"
    },
    "scripts": {
        "clean": "rimraf ./dist",
        "build": "rimraf ./dist && tsc --project ./tsconfig.build.json"
    },
    "bugs": {
        "url": "https://github.com/aklesky/node-workspace/issues"
    },
    "peerDependencies": {
        "@vitejs/plugin-rsc": "0.5.38",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "vite": "8.3.4",
        "wrangler": "4.152.0"
    },
    "peerDependenciesMeta": {
        "@vitejs/plugin-rsc": {
            "optional": true
        }
    },
    "devDependencies": {
        "@vitejs/plugin-rsc": "0.5.38",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "vite": "8.3.4",
        "wrangler": "4.152.0"
    },
    "dependencies": {
        "@aklesky/typescript-presets": "workspace:*",
        "@aklesky/vite-presets": "workspace:*",
        "@aklesky/worker-presets": "workspace:*",
        "@vitejs/plugin-react": "6.1.2",
        "oxc-transform-react": "0.152.0"
    }
}
