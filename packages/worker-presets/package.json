{
    "name": "@aklesky/worker-presets",
    "version": "0.1.1",
    "description": "Shareable Vite presets for Cloudflare Workers with static assets.",
    "author": "Aleksei Semiglasov <aleksey.semiglasov@gmail.com>",
    "homepage": "https://github.com/aklesky/node-workspace#readme",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/preset.d.ts",
            "default": "./dist/preset.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aklesky/node-workspace.git",
        "directory": "packages/worker-presets"
    },
    "scripts": {
        "clean": "rimraf ./dist",
        "build": "rimraf ./dist && tsc --project ./tsconfig.build.json"
    },
    "bugs": {
        "url": "https://github.com/aklesky/node-workspace/issues"
    },
    "peerDependencies": {
        "vite": "8.3.4",
        "wrangler": "4.152.0"
    },
    "devDependencies": {
        "@aklesky/typescript-presets": "workspace:*",
        "vite": "8.3.5",
        "wrangler": "4.152.0"
    },
    "dependencies": {
        "@aklesky/vite-presets": "workspace:*",
        "@cloudflare/vite-plugin": "1.65.0"
    }
}
